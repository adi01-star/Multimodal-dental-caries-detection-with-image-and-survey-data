{
  "_comment": "Schema for CDC NHANES 2017-March 2020 pre-pandemic lifestyle caries-risk pipeline. Defines feature fields, valid ranges, choices, and defaults matching Gradio UI.",
  "target_column": "caries_risk",
  "numeric_features": [
    {
      "name": "age",
      "label": "Age (years)",
      "min": 1,
      "max": 80,
      "default": 35
    },
    {
      "name": "sugars_intake_g",
      "label": "Daily sugar intake (grams/day)",
      "min": 0,
      "max": 400,
      "default": 90
    },
    {
      "name": "carbs_intake_g",
      "label": "Daily carbohydrate intake (grams/day)",
      "min": 0,
      "max": 600,
      "default": 220
    }
  ],
  "categorical_features": [
    {
      "name": "sex",
      "label": "Sex",
      "choices": [
        "female",
        "male"
      ],
      "default": "female"
    },
    {
      "name": "last_dental_visit",
      "label": "Last dental visit",
      "choices": [
        "within_6_months",
        "6_to_12_months",
        "1_to_2_years",
        "2_to_3_years",
        "3_to_5_years",
        "more_than_5_years",
        "never"
      ],
      "default": "within_6_months"
    },
    {
      "name": "reason_last_dental_visit",
      "label": "Reason for last dental visit",
      "choices": [
        "routine_checkup_or_cleaning",
        "called_in_or_appointment",
        "pain_or_problem",
        "other_reason",
        "never_visited"
      ],
      "default": "routine_checkup_or_cleaning"
    },
    {
      "name": "unmet_dental_need_cost",
      "label": "Needed dental care in past year but could not afford it",
      "choices": [
        "no",
        "yes"
      ],
      "default": "no"
    },
    {
      "name": "self_rated_oral_health",
      "label": "Self-rated oral health (teeth and gums)",
      "choices": [
        "excellent",
        "very_good",
        "good",
        "fair",
        "poor"
      ],
      "default": "good"
    },
    {
      "name": "smoking_status",
      "label": "Smoking status",
      "choices": [
        "never",
        "former",
        "current"
      ],
      "default": "never"
    },
    {
      "name": "diabetes_status",
      "label": "Doctor diagnosed diabetes",
      "choices": [
        "no",
        "yes"
      ],
      "default": "no"
    }
  ]
}